                 "run_attempt": 2}]})
        if rest == "/codeowners/errors":
            out({"errors": [{"line": 2, "message": "Unknown owner on line 2: make sure @ghost exists\n\n/docs/ @ghost"}]})
        if rest == "/properties/values":
            out([{"property_name": "tier", "value": "2"}])
        if rest == "/hooks":
            out([{"config": {"url": "https://ci.acme.example/hook"}}])
        if rest == "/keys":
