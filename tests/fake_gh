def ref(name, ahead, behind, date, pr=None, classic=False):
    return {"name": name, "branchProtectionRule": {"pattern": name} if classic else None,
            "compare": {"aheadBy": behind, "behindBy": ahead},  # compared from the branch to the default
            "target": {"oid": hashlib.sha1(name.encode()).hexdigest(), "committedDate": date,
                       "messageHeadline": f"Work on {name}", "author": {"name": "Ann", "user": {"login": "ann"}}},
            "associatedPullRequests": {"nodes": [pr] if pr else []}}


def pr_node(number, title, state, draft=False):
    return {"number": number, "title": title, "state": state, "isDraft": draft, "url": f"{WEB}/acme/web/pull/{number}"}


