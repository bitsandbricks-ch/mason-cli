            {"number": 3, "title": "Login fails on Safari", "state": "open", "html_url": f"{WEB}/{repo}/issues/3",
             "labels": [{"name": "bug"}], "assignees": [{"login": "mike"}], "user": {"login": "ann"}, "comments": 1,
             "created_at": "2026-11-01T09:00:00Z", "updated_at": "2026-11-05T09:00:00Z"},
