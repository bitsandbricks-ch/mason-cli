    if re.match(r"/issues/(3|7)/timeline$", rest) and params.get("page") == "1":
        out([{"event": "subscribed", "actor": {"login": "mike"}, "created_at": "2026-11-04T08:00:01Z"},
             {"event": "committed", "sha": "abc1234def", "message": "Add the login form\n\nwith a test",
              "author": {"name": "Ann", "date": "2026-11-04T07:59:00Z"}, "html_url": f"{WEB}/{repo}/commit/abc1234def"},
             {"event": "labeled", "actor": {"login": "mike"}, "label": {"name": "feature"},
              "created_at": "2026-11-04T09:00:00Z"},
             {"event": "reviewed", "user": {"login": "bob"}, "state": "changes_requested", "body": "Needs a test",
              "submitted_at": "2026-11-04T10:00:00Z", "html_url": f"{WEB}/{repo}/pull/7#review-1"},
             {"event": "commented", "actor": {"login": "ann"}, "body": "Added one.\nSee the second commit.",
              "created_at": "2026-11-04T11:00:00Z", "html_url": f"{WEB}/{repo}/pull/7#issuecomment-2"},
             {"event": "auto_squash_enabled", "actor": {"login": "mike"}, "created_at": "2026-11-04T12:00:00Z"}])
    if rest == "/commits/abc1234def/check-runs":
        out({"check_runs": [{"name": "test", "status": "completed", "conclusion": "failure", "app": {"slug": "github-actions"},
                             "started_at": "2026-11-04T08:00:00Z", "completed_at": "2026-11-04T08:01:30Z",
                             "html_url": f"{WEB}/{repo}/runs/55"}]})
    if rest == "/events":
        out([{"type": "PushEvent", "actor": {"login": "ann"}, "repo": {"name": repo}, "created_at": "2026-11-05T07:00:00Z",
              "payload": {"ref": "refs/heads/main", "size": 2, "head": "fff0000",
                          "commits": [{"message": "Fix typo"}, {"message": "Bump deps"}]}},
             {"type": "PullRequestEvent", "actor": {"login": "mike"}, "repo": {"name": repo},
              "created_at": "2026-11-05T06:00:00Z", "payload": {"action": "closed", "number": 4, "pull_request": {
                  "number": 4, "title": "Add search", "merged": True, "html_url": f"{WEB}/{repo}/pull/4"}}},
             {"type": "CreateEvent", "actor": {"login": "mike"}, "repo": {"name": repo},
              "created_at": "2026-11-05T05:00:00Z", "payload": {"ref_type": "tag", "ref": "v1.0.0"}},
             {"type": "SponsorshipEvent", "actor": {"login": "x"}, "repo": {"name": repo},
              "created_at": "2026-11-01T05:00:00Z", "payload": {}}])
    if rest == "/actions/runs/9":
        out({"id": 9, "name": "CI", "run_number": 41, "event": "push", "head_branch": "main", "head_sha": "fff0000aaa",
             "status": "completed", "conclusion": "failure", "path": ".github/workflows/ci.yml",
