        out([{"name": "sha256:aaa", "updated_at": "2026-11-05T09:00:00Z",
              "metadata": {"container": {"tags": ["1.2.0", "latest"]}}}])
    if route == "/orgs/acme/packages/container/web/versions":
        out([{"name": "sha256:bbb", "updated_at": "2026-11-05T09:00:00Z",
