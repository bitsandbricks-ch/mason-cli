# Mason settings for deploy/docker-compose.yml. Copy to .env (never commit it). All settings: docs/mason.md.

# Image tag: a release (1.2.3, 1.2, latest) or main (the newest build of main).
MASON_TAG=main

# Where people reach Mason. https:// (plain http only for localhost, private addresses and .local/.lan names).
MASON_URL=https://mason.mortar.ch
# A long random string (openssl rand -base64 48). Without it Mason makes one in the data volume.
MASON_SECRET_KEY=
# The Postgres password, letters and digits only (openssl rand -hex 24); the database is only reachable inside compose.
POSTGRES_PASSWORD=

# GitHub sign-in works without these: Mason's own OAuth app signs in with GitHub's device flow.
# For the usual redirect sign-in (click, GitHub, back signed in) set the OAuth app's client secret.
# With Mason's own app (Ov23liFJgLtIjB3ZtuOy) the secret alone is enough; for your own app set both.
# The app's "Authorization callback URL" must be https://mason.mortar.ch/api/v1/auth/github/callback.
# GITHUB_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GitHub Enterprise: GITHUB_URL=https://github.example.com

# GitLab application (optional; confidential, scope api): callback https://mason.mortar.ch/api/v1/auth/gitlab/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Self-managed GitLab: GITLAB_URL=https://gitlab.example.com

# Optional: only these may sign in. Unset, anyone with a GitHub or GitLab account may sign in
# (each user sees only their own repos and keys).
# MASON_ALLOW_USERS=github:ann, gitlab:bob   (these always get an account, whatever the caps)
# MASON_ALLOW_ORGS=github:your-org, gitlab:your-group

# Plugins switched off for every user (installed ones load unless listed here).
# MASON_PLUGINS_OFF=name

# Proxies in front that set X-Forwarded-* (compose default 1).
# MASON_TRUSTED_PROXIES=1
